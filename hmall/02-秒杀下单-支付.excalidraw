    {"type":"text","id":"d2_i_luatext","x":634,"y":442,"width":446,"height":130,"text":"local stock = tonumber(redis.call('get', KEYS[1]))\nif stock == nil or stock <= 0 then return 1 end   -- 售罄\nif redis.call('hexists', KEYS[2], ARGV[1]) == 1 then\n    return 2 end                                   -- 重复\nredis.call('decr', KEYS[1])                        -- 预扣库存\nredis.call('hset', KEYS[2], ARGV[1], ARGV[2])      -- 记录\nreturn 0                                            -- 成功","originalText":"local stock = tonumber(redis.call('get', KEYS[1]))\nif stock == nil or stock <= 0 then return 1 end   -- 售罄\nif redis.call('hexists', KEYS[2], ARGV[1]) == 1 then\n    return 2 end                                   -- 重复\nredis.call('decr', KEYS[1])                        -- 预扣库存\nredis.call('hset', KEYS[2], ARGV[1], ARGV[2])      -- 记录\nreturn 0                                            -- 成功","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200023,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
