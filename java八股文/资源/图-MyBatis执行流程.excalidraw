{"type":"text","id":"codeTxt","x":884,"y":386,"width":400,"height":240,"text":"// 典型调用链\nSqlSession session =\n    factory.openSession();\n\nUserMapper mapper =\n    session.getMapper(\n        UserMapper.class);\n\nUser u = mapper.selectById(1L);\nsession.commit();","originalText":"// 典型调用链\nSqlSession session =\n    factory.openSession();\n\nUserMapper mapper =\n    session.getMapper(\n        UserMapper.class);\n\nUser u = mapper.selectById(1L);\nsession.commit();","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3043,"version":1,"versionNonce":3043,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.6},
{"type":"text","id":"note","x":860,"y":676,"width":440,"height":60,"text":"提示：SqlSession 非线程安全，应在方法内创建并及时 close()；\nExecutor 的一级缓存以 SqlSession 为作用域。","originalText":"提示：SqlSession 非线程安全，应在方法内创建并及时 close()；\nExecutor 的一级缓存以 SqlSession 为作用域。","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3044,"version":1,"versionNonce":3044,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5}
