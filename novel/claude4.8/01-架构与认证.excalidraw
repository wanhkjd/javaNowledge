{"type":"text","id":"code_text","x":78,"y":712,"width":528,"height":146,"text":"// AuthInterceptor.preHandle\nString sys  = uri.split(\"/\")[2];\nString bean = String.format(\n    \"%sAuthStrategy\", sys);\nAuthStrategy s = factory.get(bean);\ns.auth(token, uri);  // 失败 → 抛 401","originalText":"// AuthInterceptor.preHandle\nString sys  = uri.split(\"/\")[2];\nString bean = String.format(\n    \"%sAuthStrategy\", sys);\nAuthStrategy s = factory.get(bean);\ns.auth(token, uri);  // 失败 → 抛 401","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#e2e8f0","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1311,"version":1,"versionNonce":1311,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
