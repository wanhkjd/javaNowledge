{"type":"text","id":"jwt_text","x":668,"y":712,"width":402,"height":146,"text":"JWT · jjwt (HMAC-SHA)\n────────────────\nheader.systemKeyHeader\n   = front | author | admin\npayload.sub = uid\nsecret ← novel.jwt.secret\n@ConditionalOnProperty 才装配","originalText":"JWT · jjwt (HMAC-SHA)\n────────────────\nheader.systemKeyHeader\n   = front | author | admin\npayload.sub = uid\nsecret ← novel.jwt.secret\n@ConditionalOnProperty 才装配","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1321,"version":1,"versionNonce":1321,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.35},
