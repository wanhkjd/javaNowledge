{"type":"text","id":"vipt","x":536,"y":714,"width":460,"height":144,"text":"// VIP 门控（未登录只读预览）\nif (isVip == 1 && userId == null) {\n    content = content.substring(0, 200)\n            + \"……登录并订阅后阅读全文\";\n}\n// 已登录：此处未再校验是否已购买","originalText":"// VIP 门控（未登录只读预览）\nif (isVip == 1 && userId == null) {\n    content = content.substring(0, 200)\n            + \"……登录并订阅后阅读全文\";\n}\n// 已登录：此处未再校验是否已购买","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#e2e8f0","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2311,"version":1,"versionNonce":2311,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
