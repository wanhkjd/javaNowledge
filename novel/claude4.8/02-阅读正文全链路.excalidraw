{"type":"text","id":"upst","x":1056,"y":714,"width":460,"height":144,"text":"// recordReadHistory —— UPSERT\nvar h = mapper.selectOne(userId, bookId);\nif (h != null) {           // 已读过\n    h.setPreContentId(chapterId);\n    mapper.updateById(h);\n} else {                   // 首次阅读\n    mapper.insert(new UserReadHistory(…));\n}","originalText":"// recordReadHistory —— UPSERT\nvar h = mapper.selectOne(userId, bookId);\nif (h != null) {           // 已读过\n    h.setPreContentId(chapterId);\n    mapper.updateById(h);\n} else {                   // 首次阅读\n    mapper.insert(new UserReadHistory(…));\n}","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":2313,"version":1,"versionNonce":2313,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4}
